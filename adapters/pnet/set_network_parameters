#!/bin/sh
# Called by pn_dev on a DCP Set of the IP suite: IF IP MASK GW HOSTNAME PERMANENT.
set -eu
iface=$1 ip=$2 mask=$3
printf '%s %s\n' "$(date +%s.%N)" "$*" >>/run/profinet-interop/network.log
prefix=$(echo "$mask" | awk -F. '{n=0; for(i=1;i<=4;i++){v=$i; while(v>0){n+=v%2; v=int(v/2)}} print n}')
ip address flush dev "$iface"
if [ "$ip" != "0.0.0.0" ]; then ip address add "$ip/$prefix" dev "$iface"; fi

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/profinet-interop/schemas/capabilities.schema.json",
  "title": "profinet-interop capability document",
  "description": "What `profinet-interop print-capabilities` prints (docs/CONTAINER_CONTRACT.md, contract 1.3). scripts/check-capabilities.py checks a document against it; make contract checks every image. A feature is true when the adapter supports it; a string, where allowed, says how far.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "implementation", "license", "roles", "upstream"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "implementation": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "adapterVersion": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["device", "controller", "dcp-tool", "decoder", "mrp-node", "snmp-manager"] }
    },
    "identity": { "type": "object", "description": "Device identity of a device role (vendor and device ID, modules), as the adapter states it." },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dcpIdentify": { "$ref": "#/$defs/flag" },
        "dcpIdentifyFilters": { "$ref": "#/$defs/list" },
        "dcpGet": { "$ref": "#/$defs/flag" },
        "dcpSetName": { "$ref": "#/$defs/flag" },
        "dcpSetIP": { "$ref": "#/$defs/qualified" },
        "dcpSignal": { "$ref": "#/$defs/flag" },
        "dcpReset": { "$ref": "#/$defs/flag" },
        "lldp": { "$ref": "#/$defs/flag" },
        "connect": { "$ref": "#/$defs/flag" },
        "advancedStartup": { "$ref": "#/$defs/flag" },
        "legacyStartup": { "$ref": "#/$defs/flag" },
        "rtClass1Legacy": { "$ref": "#/$defs/flag" },
        "rtClass2Advanced": { "$ref": "#/$defs/flag" },
        "frameIdRange": { "$ref": "#/$defs/text" },
        "cyclic": { "$ref": "#/$defs/flag" },
        "moduleDiff": { "$ref": "#/$defs/flag" },
        "readWrite": { "$ref": "#/$defs/flag" },
        "recordRead": { "$ref": "#/$defs/flag" },
        "recordWrite": { "$ref": "#/$defs/flag" },
        "writeMultiple": { "$ref": "#/$defs/flag" },
        "readImplicit": { "$ref": "#/$defs/flag" },
        "im0": { "$ref": "#/$defs/flag" },
        "im0to3": { "$ref": "#/$defs/flag" },
        "im0to4": { "$ref": "#/$defs/flag" },
        "im4": { "$ref": "#/$defs/flag" },
        "diagnosis": { "$ref": "#/$defs/flag" },
        "diagnosisRecords": { "$ref": "#/$defs/flag" },
        "alarms": { "$ref": "#/$defs/qualified" },
        "processAlarms": { "$ref": "#/$defs/flag" },
        "reparameterize": { "$ref": "#/$defs/flag" },
        "iosar": { "$ref": "#/$defs/flag" },
        "multipleAR": { "$ref": "#/$defs/flag" },
        "multipleIOCAR": { "$ref": "#/$defs/flag" },
        "epm": { "$ref": "#/$defs/flag" },
        "rpcFragmentation": { "$ref": "#/$defs/flag" },
        "gsdml": { "$ref": "#/$defs/flag" },
        "snmp": { "$ref": "#/$defs/flag" },
        "mrm": { "$ref": "#/$defs/flag" },
        "mrc": { "$ref": "#/$defs/flag" },
        "mra": { "$ref": "#/$defs/flag" },
        "interconnection": { "$ref": "#/$defs/flag" },
        "recoveryProfiles": { "$ref": "#/$defs/list" },
        "kernelMRP": { "$ref": "#/$defs/flag" },
        "requires": { "$ref": "#/$defs/text" },
        "ifdriver": { "$ref": "#/$defs/text" },
        "versions": { "$ref": "#/$defs/list" },
        "operations": { "$ref": "#/$defs/list" },
        "mibs": { "$ref": "#/$defs/flag" }
      }
    },
    "upstream": {
      "type": "object",
      "required": ["name", "version", "independentEngine"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "revision": { "type": "string" },
        "independentEngine": { "type": "boolean", "description": "false for an image whose stack is not independent of the systems tested against it (adapter otfabric)." }
      }
    }
  },
  "$defs": {
    "flag": { "type": "boolean" },
    "qualified": {
      "description": "true or false, or a string that says how far the support goes.",
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "not": { "enum": ["true", "false"] } }
      ]
    },
    "text": { "type": "string", "minLength": 1 },
    "list": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
